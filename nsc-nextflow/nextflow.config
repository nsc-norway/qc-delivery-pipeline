params {
    pipeline_version = "2.0"
    reportdir = "$launchDir/90_reports/"
    containerdir = "/data/runScratch.boston/analysis/pipelines/container-images/"
    deliverydir = "/data/runScratch.boston/demultiplexed/delivery"
    passwordTool = "/data/runScratch.boston/scripts/getPassword.sh"
}

singularity {
    enabled = true
    autoMounts = true
    runOptions = "-B ./.singularity-tmp:/tmp:rw"
}

process {
    executor = "slurm"
    clusterOptions = "--qos high"
    maxRetries = 999
    cpus = 1
    memory = '8 GB'
    //time = '1d' // One day is default
   
    // BeforeScript required by singularity for tmp
    beforeScript = "mkdir ./.singularity-tmp"
    afterScript = "rm -rf ./.singularity-tmp"

    withName:SUPRDUPR {
        cpus = 2
        memory = '16 GB'
    }
    withName:MULTIQC {
        memory = '32 GB'
    }
    withName:PROJECT_CREDENTIALS {
        container = null
    }
}

executor {
    queueSize = 500
}

report {
    enabled = true
    overwrite = true
    file = "$params.reportdir/nextflow_report.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "$params.reportdir/nextflow_timeline.html"
}

dag {
    enabled = true
    overwrite = true
    file = "$params.reportdir/nextflow_flowchart.html"
}

cleanup = true
