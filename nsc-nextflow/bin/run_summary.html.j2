<!doctype html>

<html>
<head>
<title>Run summary</title>
<meta charset="UTF-8">
</head>

<style>
body {
    margin-bottom: 30px;
}

table {
    border-collapse: collapse;
    margin: 5px;
}
table, th, td {
    border: 1px solid black;
}
table.lims_info {
    margin-top: 20px;
    margin-bottom: 20px;
}
td {
    padding: 3px;
}
td.number {
    text-align: center;
}
td.center {
    text-align: center;
}
td.text {
}
</style>

<body>
<table>
<tr>
{% for cell in lane_header %}
    <th>{{ cell }}</th>
{% endfor %}
</tr>
{% for row in lane_data %}
<tr>
{% for cell in zip(lane_classes, row) %}
    <td class="{{ cell[0] }}">{{ cell[1] }}</td>
{% endfor %}
</tr>
{% endfor %}
</table>

{% if run_parameters %}
<h3>Run parameters</h3>
<table>
    <tr>
        <td>Instrument</td>
        <td>{{ run_parameters.instrument_type }}</td>
        <td>{{ run_parameters.instrument_id }} ({{ run_parameters.instrument_name }})</td>
    </tr>
    {% if run_parameters.run_mode_field %}
    <tr>
        <td>Parameter</td>
        <td>{{ run_parameters.run_mode_field }}</td>
        <td>{{ run_parameters.run_mode_value }}</td>
    </tr>
    {% endif %}
    <tr>
        <td>Cycles</td>
        <td>{{ run_parameters.cycles[0][0] }}</td>
        <td>{{ run_parameters.cycles[0][1] }}</td>
    </tr>
    {% for cycles in run_parameters.cycles[1:] %}
    <tr>
        <td></td>
        <td>{{ cycles[0] }}</td>
        <td>{{ cycles[1] }}</td>
    </tr>
    {% endfor %}
</table>
<h4>Versions</h4>
<table>
{% for row in software_versions %}
    <tr><td>{{ row[0] }}</td><td>{{ row[1] }}</td></tr>
{% endfor %}
</table>
{% endif %}

<h2>Projects</h2>
{% for project_data in project_datas %}
<h3>{{ project_data['ProjectName'] }}</h3>
<p>Sequence ready for download - sequencing run {{ run_parameters.run_id }} - {{ project_data['ProjectName'] }} ({{ project_data['number_of_samples'] }} samples)</p>
<table class="lims_info">
    <tr><td>Contact person</td><td>{{ project_data['ContactPerson'] }}</td></tr>
    <tr><td>Contact email</td><td>{{ project_data['ContactEmail'] }}</td></tr>
    <tr><td>Delivery method</td><td>{{ project_data['DeliveryMethod'] }}</td></tr>
    <tr><td>Directory name</td><td>{{ project_data['dir_name'] }}</td></tr>
</table>
<table>
{% for (sample, frags, rel_frags) in project_data['sample_fragments_table'] %}
<tr>
    <td>{{ sample }}</td>
    <td>{{ "{0:,}".format(frags) }} fragments</td>
    <td>{{ "{0:+.01f}".format(rel_frags*100) }} %</td>
</tr>
{% endfor %}
</table>
{% endfor %}

<p>&nbsp;</p>
<p>Regards</p>
<p>Arvind/Marius (Check who has sent the email &#128540;)</p>
</body>
</html>
