nextflow_workflow {

    name "Test QC delivery pipeline"
    script "main.nf"
    workflow "QC_DELIVERY_PIPELINE"

    def deleteDirectory = { directory ->
        if (java.nio.file.Files.exists(directory)) {
            def fileStream = java.nio.file.Files.walk(directory)
            try {
                fileStream
                    .sorted(java.util.Comparator.reverseOrder())
                    .forEach { file -> java.nio.file.Files.delete(file) }
            } finally {
                fileStream.close()
            }
        }
    }

    // This is a generic test definition to run the pipeline and verify the output files.
    // Specific tests are defined below.
    def fixtureTest = { fixture ->
        test(fixture.name) {

            when {
                params {
                    def fixtureDir = "${projectDir}/../tests/fixtures/${fixture.runId}"
                    def resultsDir = "${projectDir}/.nf-test/results/${fixture.resultsDir}"
                    def inputRunFolder = fixtureDir
                    deleteDirectory(java.nio.file.Paths.get(resultsDir))

                    if (fixture.containsKey("sapioInfo")) {
                        def sourceRunFolder = java.nio.file.Paths.get(fixtureDir)
                        def testRunFolder = java.nio.file.Paths.get("${projectDir}/.nf-test/input-runs/${fixture.resultsDir}/${fixture.runId}")
                        def testSapioInfo = testRunFolder.resolve("NscSapioInfo.yaml")
                        def sourceFiles = java.nio.file.Files.walk(sourceRunFolder)
                        // Copy the content of the run folder into the new fixture directory
                        try {
                            sourceFiles.forEach { sourceFile ->
                                def targetFile = testRunFolder.resolve(sourceRunFolder.relativize(sourceFile))
                                if (java.nio.file.Files.isDirectory(sourceFile)) {
                                    java.nio.file.Files.createDirectories(targetFile)
                                } else {
                                    java.nio.file.Files.copy(
                                        sourceFile,
                                        targetFile,
                                        java.nio.file.StandardCopyOption.REPLACE_EXISTING
                                    )
                                }
                            }
                        } finally {
                            sourceFiles.close()
                        }
                        // Replace or remove the SapioInfo file
                        java.nio.file.Files.deleteIfExists(testSapioInfo)
                        if (fixture.sapioInfo != null) {
                            java.nio.file.Files.copy(
                                java.nio.file.Paths.get("${projectDir}/tests/fixtures/${fixture.sapioInfo}"),
                                testSapioInfo,
                                java.nio.file.StandardCopyOption.REPLACE_EXISTING
                            )
                        }
                        inputRunFolder = testRunFolder.toString()
                    }

                    runFolder = inputRunFolder
                    analysisDir = "${fixtureDir}/${fixture.analysisDir}"
                    outdir = "${resultsDir}/outdir"
                    deliveryDir = "${resultsDir}/delivery"
                    putAll(fixture.params)
                }
            }

            then {
                assert workflow.success

                def resultsDir = path("${projectDir}/.nf-test/results/${fixture.resultsDir}")
                def relativeFileNames = { directory ->
                    if (!directory.exists()) {
                        return []
                    }
                    def fileStream = java.nio.file.Files.walk(directory)
                    try {
                        fileStream
                            .filter { file -> java.nio.file.Files.isRegularFile(file) }
                            .map { file -> directory.relativize(file).toString() }
                            .sorted()
                            .toList()
                    } finally {
                        fileStream.close()
                    }
                }
                def channelFileNames = { channel ->
                    channel.collect { entry ->
                        def output = entry instanceof List ? entry.last() : entry
                        java.nio.file.Paths.get(output.toString()).getFileName().toString()
                    }.sort()
                }

                assert snapshot([
                    published: relativeFileNames(resultsDir.resolve("outdir")),
                    delivery: relativeFileNames(resultsDir.resolve("delivery")),
                    fastqs: channelFileNames(workflow.out.fastqs),
                    md5sum: channelFileNames(workflow.out.md5sum),
                    fastqcHtml: channelFileNames(workflow.out.fastqc_html),
                    suprdupr: channelFileNames(workflow.out.suprdupr),
                    multiqc: channelFileNames(workflow.out.multiqc),
                    nirdDelivery: channelFileNames(workflow.out.nird_delivery),
                    linkedDelivery: channelFileNames(workflow.out.linked_delivery)
                ]).match("${fixture.name} output files")
            }
        }
    }

    [
        [
            name: "NovaSeqX.20260625.c2",
            runId: "20260625_LH00534_0319_A22JKHGLT1",
            analysisDir: "Analysis/c2",
            resultsDir: "20260625-c2",
            params: [:]
        ],
        [
            name: "NovaSeqX.20260625.c2.NoSapioInfo",
            runId: "20260625_LH00534_0319_A22JKHGLT1",
            analysisDir: "Analysis/c2",
            resultsDir: "20260625-c2-no-sapio-info",
            params: [:],
            sapioInfo: null
        ],
        [
            name: "NovaSeqX.20260625.c2.PartialSapioProjectMismatch",
            runId: "20260625_LH00534_0319_A22JKHGLT1",
            analysisDir: "Analysis/c2",
            resultsDir: "20260625-c2-partial-sapio-project-mismatch",
            params: [fallbackDeliveryMethod: "NIRD"],
            sapioInfo: "nsc-sapio-info-one-project-mismatch.yaml"
        ],
        [
            name: "MiSeq.20260715.3",
            runId: "20260715_SH01006_0020_ASC2245414-SC3",
            analysisDir: "Analysis/3",
            resultsDir: "main-smoke",
            params: [:]
        ],
        [
            // Test QC disabled completely. This is not a normal configuration, but we can use it if the QC tools can't handle the
            // fastq files in the dataset.
            name: "MiSeq.20260715.c1.QcOff",
            runId: "20260715_SH01006_0020_ASC2245414-SC3",
            analysisDir: "Analysis/c1",
            resultsDir: "20260715-c1",
            params: [enableFastQC: false, enableSuprdupr: false]
        ],
        [
            name: "MiSeq.20260715.c2",
            runId: "20260715_SH01006_0020_ASC2245414-SC3",
            analysisDir: "Analysis/c2",
            resultsDir: "20260715-c2",
            params: [:]
        ],
        [
            name: "NovaSeqX.20260804.2",
            runId: "20260804_LH00770_0246_A22JJTLLT1",
            analysisDir: "Analysis/2",
            resultsDir: "20260804-2",
            params: [:]
        ],
        [
            name: "NovaSeqX.20260804.3.DragenFastQC",
            runId: "20260804_LH00770_0246_A22JJTLLT1",
            analysisDir: "Analysis/3",
            resultsDir: "20260804-3",
            params: [enableFastQC: false]
        ]
    ].each(fixtureTest)
}