    test("runs the NovaSeq X onboard 3 fixture") {

        when {
            params {
                def fixtureDir = "${projectDir}/../tests/fixtures/20260804_LH00770_0246_A22JJTLLT1"
                def resultsDir = "${projectDir}/.nf-test/results/20260804-3"

                runFolder = fixtureDir
                bclConvertFastqDir = "${fixtureDir}/Analysis/3/Data/BCLConvert"
                outdir = "${resultsDir}/outdir"
                deliveryDir = "${resultsDir}/delivery"
            }
        }

        then {
            assert workflow.success

            def resultDir = path("${projectDir}/.nf-test/results/20260804-3")
            def outputRunDir = resultDir.resolve("outdir/20260804_LH00770_0246_A22JJTLLT1")
            def exampleProjectDir = outputRunDir.resolve("260804_LH00770.A.Project_Example-test2-2026-07-28")
            def testcaseProjectDir = outputRunDir.resolve("260804_LH00770.A.Project_Testcase-test3-2026-08-04")
            def deliveryDir = resultDir.resolve("delivery")

            assert exampleProjectDir.resolve("md5sum.txt").exists()
