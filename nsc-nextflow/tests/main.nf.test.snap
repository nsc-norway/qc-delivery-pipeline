                    "Summary_for_20260804_LH00770_0246_A22JJTLLT1.html": "<!doctype html>\n\n<html>\n<head>\n<title>Run summary</title>\n<meta charset=\"UTF-8\">\n</head>\n\n<style>\nbody {\n    margin-bottom: 30px;\n}\n\ntable {\n    border-collapse: collapse;\n    margin: 5px;\n}\ntable, th, td {\n    border: 1px solid black;\n}\ntable.lims_info {\n    margin-top: 20px;\n    margin-bottom: 20px;\n}\ntd {\n    padding: 3px;\n}\ntd.number {\n    text-align: center;\n}\ntd.center {\n    text-align: center;\n}\ntd.text {\n}\n</style>\n\n<body>\n<table>\n<tr>\n\n    <th>Lane</th>\n\n    <th>Project</th>\n\n    <th>PF cluster no</th>\n\n    <th>PF ratio</th>\n\n    <th>SeqDuplicates</th>\n\n    <th>Undetermined</th>\n\n    <th>AlignPhixR1</th>\n\n    <th>AlignPhixR2</th>\n\n    <th>>=Q30</th>\n\n    <th>Occupied</th>\n\n    <th>Informative</th>\n\n    <th>MaxReadsSam</th>\n\n    <th>MinReadsSam</th>\n\n    <th>Quality</th>\n\n</tr>\n\n<tr>\n\n    <td class=\"center\">1</td>\n\n    <td class=\"text\">Example-test2-2026-07-28</td>\n\n    <td class=\"number\">1,068,913,291</td>\n\n    <td class=\"number\">76.7 %</td>\n\n    <td class=\"number\">0.00 %</td>\n\n    <td class=\"number\">6.78 %</td>\n\n    <td class=\"number\">1.01 %</td>\n\n    <td class=\"number\">0.99 %</td>\n\n    <td class=\"number\">91.75 %</td>\n\n    <td class=\"number\">95.48 %</td>\n\n    <td class=\"number\">71.45 %</td>\n\n    <td class=\"number\">+61.4%</td>\n\n    <td class=\"number\">-34.5%</td>\n\n    <td class=\"text\">ok</td>\n\n</tr>\n\n<tr>\n\n    <td class=\"center\">2</td>\n\n    <td class=\"text\">Testcase-test3-2026-08-04</td>\n\n    <td class=\"number\">1,146,009,258</td>\n\n    <td class=\"number\">82.2 %</td>\n\n    <td class=\"number\">0.00 %</td>\n\n    <td class=\"number\">5.14 %</td>\n\n    <td class=\"number\">0.66 %</td>\n\n    <td class=\"number\">0.65 %</td>\n\n    <td class=\"number\">91.56 %</td>\n\n    <td class=\"number\">98.13 %</td>\n\n    <td class=\"number\">77.95 %</