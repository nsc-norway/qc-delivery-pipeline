                    "Summary_for_20260715_SH01006_0020_ASC2245414-SC3.html": "<!doctype html>\n\n<html>\n<head>\n<title>Run summary</title>\n<meta charset=\"UTF-8\">\n</head>\n\n<style>\nbody {\n    margin-bottom: 30px;\n}\n\ntable {\n    border-collapse: collapse;\n    margin: 5px;\n}\ntable, th, td {\n    border: 1px solid black;\n}\ntable.lims_info {\n    margin-top: 20px;\n    margin-bottom: 20px;\n}\ntd {\n    padding: 3px;\n}\ntd.number {\n    text-align: center;\n}\ntd.center {\n    text-align: center;\n}\ntd.text {\n}\n</style>\n\n<body>\n<table>\n<tr>\n\n    <th>Lane</th>\n\n    <th>Project</th>\n\n    <th>PF cluster no</th>\n\n    <th>PF ratio</th>\n\n    <th>SeqDuplicates</th>\n\n    <th>Undetermined</th>\n\n    <th>AlignPhixR1</th>\n\n    <th>AlignPhixR2</th>\n\n    <th>>=Q30</th>\n\n    <th>Occupied</th>\n\n    <th>Informative</th>\n\n    <th>MaxReadsSam</th>\n\n    <th>MinReadsSam</th>\n\n    <th>Quality</th>\n\n</tr>\n\n<tr>\n\n    <td class=\"center\">1</td>\n\n    <td class=\"text\">Test-Libs6-2026-06-22</td>\n\n    <td class=\"number\">5,567,926</td>\n\n    <td class=\"number\">70.4 %</td>\n\n    <td class=\"number\">0.02 %</td>\n\n    <td class=\"number\">79.19 %</td>\n\n    <td class=\"number\">3.66 %</td>\n\n    <td class=\"number\">3.58 %</td>\n\n    <td class=\"number\">93.92 %</td>\n\n    <td class=\"number\">81.51 %</td>\n\n    <td class=\"number\">14.65 %</td>\n\n    <td class=\"number\">+75.0%</td>\n\n    <td class=\"number\">-90.3%</td>\n\n    <td class=\"text\">ok</td>\n\n</tr>\n\n</table>\n\n\n<h3>Run parameters</h3>\n<table>\n    <tr>\n        <td>Instrument</td>\n        <td>MiSeqi100Plus</td>\n        <td>SH01006 ()</td>\n    </tr>\n    \n    <tr>\n        <td>Cycles</td>\n        <td>R1</td>\n        <td>151</td>\n    </tr>\n    \n    <tr>\n        <td></td>\n        <td>I1</td>\n        <td>11</td>\n    </tr>\n    \n    <tr>\n        <td></td>\n        <td>I2</td>\n        <td>11</td>\n    </tr>\n    \n    <tr>\n        <td></td>\n        <td>R2</td>\n        <td>151</td>\n    </tr>\n    \n</table>\n<h4>Versions</h4>\n<table>\n\n    <tr><td>MiSeqi100Plus System Suite</td><td>1.1.0.26158</td></tr>\n\n    <tr><td>BCL Convert</td><td>4.4.6</td></tr>\n\n    <tr><td>NSC scripts</td><td>3.0</td></tr>\n\n</table>\n\n\n<h2>Projects</h2>\n\n<h3>Test-Libs6-2026-06-22</h3>\n<p>Sequence ready for download - sequencing run 20260715_SH01006_0020_ASC2245414-SC3 - Test-Libs6-2026-06-22 (22 samples)</p>\n<table class=\"lims_info\">\n    <tr><td>Contact person</td><td>Tora Test</td></tr>\n    <tr><td>Contact email</td><td>tora.test@example.org</td></tr>\n    <tr><td>Delivery method</td><td>NIRD</td></tr>\n    <tr><td>Directory name</td><td>260715_SH01006.A.Project_Test-Libs6-2026-06-22</td></tr>\n</table>\n<table>\n\n<tr>\n    <td>22-miseq22_L001</td>\n    <td>8,928 fragments</td>\n    <td>-83.1 %</td>\n</tr>\n\n<tr>\n    <td>21-miseq21_L001</td>\n    <td>60,579 fragments</td>\n    <td>+15.0 %</td>\n</tr>\n\n<tr>\n    <td>20-miseq20_L001</td>\n    <td>56,225 fragments</td>\n    <td>+6.7 %</td>\n</tr>\n\n<tr>\n    <td>19-miseq19_L001</td>\n    <td>5,107 fragments</td>\n    <td>-90.3 %</td>\n</tr>\n\n<tr>\n    <td>18-miseq18_L001</td>\n    <td>91,083 fragments</td>\n    <td>+72.9 %</td>\n</tr>\n\n<tr>\n    <td>17-miseq17_L001</td>\n    <td>53,043 fragments</td>\n    <td>+0.7 %</td>\n</tr>\n\n<tr>\n    <td>16-miseq16_L001</td>\n    <td>6,723 fragments</td>\n    <td>-87.2 %</td>\n</tr>\n\n<tr>\n    <td>15-miseq15_L001</td>\n    <td>66,354 fragments</td>\n    <td>+26.0 %</td>\n</tr>\n\n<tr>\n    <td>14-miseq14_L001</td>\n    <td>61,667 fragments</td>\n    <td>+17.1 %</td>\n</tr>\n\n<tr>\n    <td>13-miseq13_L001</td>\n    <td>5,480 fragments</td>\n    <td>-89.6 %</td>\n</tr>\n\n<tr>\n    <td>12-miseq12_L001</td>\n    <td>53,544 fragments</td>\n    <td>+1.6 %</td>\n</tr>\n\n<tr>\n    <td>11-miseq11_L001</td>\n    <td>41,226 fragments</td>\n    <td>-21.7 %</td>\n</tr>\n\n<tr>\n    <td>10-miseq10_L001</td>\n    <td>58,